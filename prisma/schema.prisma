generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  name                  String?
  passwordHash          String?
  currency              String        @default("GBP")
  targetWeight          Decimal?      @db.Decimal(5, 2)
  assistantHabits       Boolean       @default(true)
  assistantWeight       Boolean       @default(false)
  assistantExpenses     Boolean       @default(false)
  telegramHabitChatId   String?       @unique
  telegramExpenseChatId String?       @unique
  createdAt             DateTime      @default(now())
  habits                Habit[]
  habitLogs             HabitLog[]
  expenses              Expense[]
  recurringPayments     RecurringPayment[]
  expenseCategoryRules  ExpenseCategoryRule[]
  reminderLogs          ReminderLog[]
  weightLogs            WeightLog[]
  telegramConnectionCodes TelegramConnectionCode[]
  weeklyAiReports       WeeklyAiReport[]
}

model EmailVerificationToken {
  id                  String   @id @default(cuid())
  email               String
  token               String   @unique
  pendingName         String
  pendingPasswordHash String
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model TelegramConnectionCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Habit {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  code            String
  active          Boolean       @default(true)
  reminderTime    String
  reminderMessage String
  icon            String        @default("circle")
  colour          String        @default("emerald")
  validReplies    String[]
  retryTimes      String[]
  scheduleDays    String[]
  createdAt       DateTime      @default(now())
  logs            HabitLog[]
  reminderLogs    ReminderLog[]

  @@unique([userId, code])
  @@index([userId])
}

model HabitLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String
  habit     Habit       @relation(fields: [habitId], references: [id], onDelete: Cascade)
  status    HabitStatus
  source    LogSource
  replyText String?
  loggedAt  DateTime
  createdAt DateTime    @default(now())

  @@index([habitId])
  @@index([userId, loggedAt])
}

model ReminderLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId       String
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  sentAt        DateTime @default(now())
  scheduledTime String
  type          String

  @@unique([userId, habitId, scheduledTime, type])
  @@index([userId, sentAt])
  @@index([habitId])
}

model Expense {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(10, 2)
  description String
  rawText     String
  category    ExpenseCategory?
  confidence  Float?
  source      String
  createdVia  String           @default("telegram")
  expenseDate DateTime
  recurringPaymentId String?
  recurringPayment   RecurringPayment? @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)
  recurringForMonth  String?
  createdAt   DateTime         @default(now())

  @@index([userId, expenseDate])
  @@index([recurringPaymentId])
  @@unique([recurringPaymentId, recurringForMonth])
}

model RecurringPayment {
  id          String                    @id @default(cuid())
  userId      String
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amount      Decimal                   @db.Decimal(10, 2)
  category    ExpenseCategory
  frequency   RecurringPaymentFrequency @default(MONTHLY)
  dayOfMonth  Int
  nextRunAt   DateTime
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  expenses    Expense[]

  @@index([userId])
  @@index([isActive, nextRunAt])
}

model ExpenseCategoryRule {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  ExpenseCategory
  keyword   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, category, keyword])
  @@index([userId])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Decimal  @db.Decimal(5, 2)
  source    String   @default("dashboard")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model WeeklyAiReport {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart     DateTime
  weekEnd       DateTime
  metricsJson   Json
  reportText    String   @db.Text
  model         String
  createdAt     DateTime @default(now())
  regeneratedAt DateTime?

  @@unique([userId, weekStart])
  @@index([userId])
}

enum HabitStatus {
  DONE
  SKIPPED
  MISSED
}

enum LogSource {
  telegram
  dashboard
}

enum ExpenseCategory {
  GROCERIES
  TAKEAWAY
  COFFEE_SNACKS
  TRANSPORT
  PERSONAL_CARE
  ENTERTAINMENT
  SUBSCRIPTIONS
  INSURANCE
  SHOPPING
  HOUSEHOLD
  HOUSING_BILLS
  PETS
  HEALTH
  WORK
  INCOME
  OTHER
}

enum RecurringPaymentFrequency {
  MONTHLY
}
