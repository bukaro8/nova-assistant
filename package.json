{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --names web,nova,scheduler --prefix-colors cyan,green,yellow \"npm run dev\" \"npm run telegram:nova\" \"npm run telegram:habit:scheduler\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "telegram:expense": "node --env-file=.env --import tsx src/server/telegram/expense-bot.ts",
    "telegram:expense:prod": "node --import tsx src/server/telegram/expense-bot.ts",
    "telegram:expense:test": "node --env-file=.env --import tsx src/server/telegram/expense-bot.ts --test",
    "telegram:habit": "node --env-file=.env --import tsx src/server/telegram/habit-bot.ts",
    "telegram:habit:delete-webhook": "node --env-file=.env --import tsx src/server/telegram/habit-bot.ts --delete-webhook",
    "telegram:habit:dev": "node --env-file=.env --import tsx src/server/telegram/habit-dev.ts",
    "telegram:habit:prod": "node --import tsx src/server/telegram/habit-bot.ts",
    "telegram:habit:scheduler": "node --env-file=.env --import tsx src/server/telegram/habit-scheduler.ts",
    "telegram:habit:test": "node --env-file=.env --import tsx src/server/telegram/habit-bot.ts --test",
    "telegram:nova": "node --env-file=.env --import tsx src/server/telegram/nova-bot.ts",
    "telegram:nova:prod": "node --import tsx src/server/telegram/nova-bot.ts",
    "telegram:nova:test": "node --env-file=.env --import tsx src/server/telegram/nova-bot.ts --test",
    "telegram:scheduler:prod": "node --import tsx src/server/telegram/habit-scheduler.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
